<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The two newest .NET LTS releases, plus netstandard2.0 as the entry point for older systems (.NET Framework 4.6.1+, Mono, Unity), like Primitives, which it uses. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022.Validation.Xml</RootNamespace>
    <AssemblyName>BeneficialStrategies.Iso20022.Validation.Xml</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageFiles>$(MSBuildThisFileDirectory)..\..\artifacts\package\</PackageFiles>
    <PackageId>BeneficialStrategies.Iso20022.Validation.Xml</PackageId>
    <PackageDescription>Validate ISO 20022 XML straight from text, a document or an element: every problem in the XML is reported with its path, then the FluentValidation rules run on what was read. Needs only the Primitives package, not the message definitions.</PackageDescription>
    <!-- The README and the release notes of a release are made by tools/package/prepare_package_files.py; without them (a local pack) the README of the repository is used. -->
    <PackageReleaseNotes Condition="Exists('$(PackageFiles)release-notes.txt')">$([System.IO.File]::ReadAllText("$(PackageFiles)release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PackageFiles)README.md" Pack="true" PackagePath="\" Condition="Exists('$(PackageFiles)README.md')" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="!Exists('$(PackageFiles)README.md')" />
    <None Include="..\..\.beneficial\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.*" />
    <!-- From the lowest version that works to just below the next breaking change. -->
    <PackageReference Include="BeneficialStrategies.Iso20022.Primitives" Version="[1.1.1, 1.2.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" Version="11.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
